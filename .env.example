# ---------------------------------------------------------------------------
# Base de données PostgreSQL (Neon, Supabase, Docker local...)
# Neon : ajoute ?sslmode=require à la fin de l'URL
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# ---------------------------------------------------------------------------
# NextAuth — secret : openssl rand -base64 32
# NEXTAUTH_URL doit valoir l'URL publique en production (https://mon-site.vercel.app)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="remplace-moi-par-un-secret-aleatoire"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# UploadThing — jeton depuis https://uploadthing.com/dashboard (onglet API Keys)
# ---------------------------------------------------------------------------
UPLOADTHING_TOKEN=""

# ---------------------------------------------------------------------------
# Compte admin unique, créé par `pnpm db:seed` (aucune inscription publique)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@exemple.com"
ADMIN_PASSWORD="motdepasse-solide"
